{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" statusline", "refreshInterval": 30 },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" session-start", "timeout": 15 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" prompt", "timeout": 15 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" pre-tool", "timeout": 15 }] }],
    "PostToolBatch": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" post-batch", "timeout": 15 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" stop", "timeout": 15 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-guard.mjs\" pre-compact", "timeout": 15 }] }]
  }
}
