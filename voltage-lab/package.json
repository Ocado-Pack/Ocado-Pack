{
  "name": "voltage-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Voltage Lab: From Zero to Confident Measurements — an interactive 3D voltmeter training simulator",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/voltage-lab.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/voltage-lab.js --watch --servedir=. --serve=5173",
    "start": "node serve.mjs",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "three": "^0.170.0"
  }
}
